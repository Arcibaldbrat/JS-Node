<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/style.css" />
    <link rel="stylesheet" href="/css/account-menu.css" />
    <script defer src="/js/account-menu.js"></script>
    <title><%= titulek %></title>
</head>
<body>
    <main>
        <h1><%= titulek %></h1>
        <p>Přihlášený uživatel: <strong><%= user.email %></strong></p>
        <section class="account-danger" id="zrusit-ucet">
            <h2>Zrušit účet</h2>
            <p>Tuto akci nelze vrátit zpět. Pro potvrzení zadejte své heslo.</p>
            <% if(chyba) { %><p class="form-error" role="alert"><%= chyba %></p><% } %>
            <form action="/account/delete" method="post">
                <label for="delete-password">Heslo</label><br />
                <input id="delete-password" name="password" type="password" maxlength="128" required autocomplete="current-password" /><br />
                <button type="submit">Trvale zrušit účet</button>
            </form>
        </section>
        <p><a href="/">Zpět na úvod</a></p>
    </main>
</body>
</html>
